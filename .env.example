# Preencher com valores reais em .env (NUNCA commitar o .env)

# Segredo da assinatura HMAC das janelas de QR (gerar: openssl rand -hex 32)
QR_HMAC_SECRET=

# Intervalo de rotação do QR das estações, em segundos
QR_ROTATION_SECONDS=45

# Conexão com o PostgreSQL (ADR-002) — ex: postgres://usuario:senha@localhost:5432/vitrine
DATABASE_URL=

# Chave do Django (gerar: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# Credenciais do admin (forma final depende da spec 05)
ADMIN_USER=
ADMIN_PASSWORD_HASH=
