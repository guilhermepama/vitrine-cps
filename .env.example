# Copie para .env e preencha (NUNCA commitar o .env).
# O .env só é lido no desenvolvimento local; em produção, use as variáveis
# de ambiente da plataforma.

# --- Django ---
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 só no seu computador. Em produção, 0.
DJANGO_DEBUG=1
# Domínios separados por vírgula (produção). Com DEBUG=1 e vazio: localhost.
DJANGO_ALLOWED_HOSTS=
# Origens com https://, separadas por vírgula (produção).
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 se a plataforma não redirecionar HTTP→HTTPS sozinha.
DJANGO_SECURE_SSL_REDIRECT=0

# --- Banco (PostgreSQL — ADR-002) ---
# Local (docker compose): postgres://vitrine:vitrine@localhost:5432/vitrine
# Neon: copie a connection string do painel (termina com ?sslmode=require)
DATABASE_URL=

# --- Cadastro (spec 01) ---
# HMAC do RA do representante. Diferente do QR_HMAC_SECRET.
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
RA_HMAC_SECRET=

# --- Votação (spec 03) ---
# Segredo da assinatura HMAC das janelas de QR (gerar: openssl rand -hex 32)
QR_HMAC_SECRET=
# HMAC do IP na chave do rate limit da emissão. Diferente do QR e do RA.
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
IP_HMAC_SECRET=
# (A rotação do QR é fixa em 45 s na spec 03 — não é configurável.)

# --- Imagens — Cloudflare R2 (ADR-006). Credencial restrita ao bucket. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domínio público das imagens (não usar *.r2.dev em produção)
R2_PUBLIC_DOMAIN=
